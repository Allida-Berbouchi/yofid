POST http://localhost:4000/api/users/register
Content-Type: application/json

{
  "name": "alaida",
  "email": "alada@allaida.com",
  "password": "123456",
}

### Login
POST http://localhost:4000/api/users/login
Content-Type: application/json

{
  "email": "allida@allida.com",
  "password": "12345"
}

### -------------------------
# 3. Create Content (as user)
# -------------------------
POST http://localhost:4000/api/content/
Content-Type: application/json
Authorization: Bearer I_am_not_vlalid

{
  "title": "Introduction to Math",
  "description": "Basic math concepts",
  "type": "article",
  "category": "Math",
  "subject": "Algebra",
  "gradeLevel": "5",
  "url": "https://example.com/math-intro"
}

###

# -------------------------
# 4. Submit Content for Approval (adds to queue)
# -------------------------
POST http://localhost:5000/api/content/submit
Content-Type: application/json
Authorization: Bearer <YOUR_JWT_TOKEN>

{
  "contentId": "<PASTE_CONTENT_ID_HERE>"
}